<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pure OLED Black (#000000) iOS Dynamic Island Capsule -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF000000"
                android:centerColor="#FF030305"
                android:endColor="#FF07070A"
                android:angle="270" />
            <corners android:radius="44dp" />
        </shape>
    </item>
    <!-- Subtle iOS Top Specular Glass Rim -->
    <item android:top="1dp" android:left="10dp" android:right="10dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="44dp" />
        </shape>
    </item>
    <!-- Crimson & Metallic Hairline Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="44dp" />
            <stroke
                android:width="1.3dp"
                android:color="#77D71921" />
        </shape>
    </item>
</layer-list>
