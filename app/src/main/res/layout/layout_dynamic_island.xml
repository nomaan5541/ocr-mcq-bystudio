<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/island_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dynamic_island"
    android:elevation="24dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Row 1: Authentic Apple iOS Dynamic Island Top Capsule -->
    <LinearLayout
        android:id="@+id/island_top_row"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left TrueDepth Sensor / Lens Orb (Tap to expand Live Activity deck) -->
        <FrameLayout
            android:id="@+id/island_icon_container"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_ios_island_lens"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tap to expand Dynamic Island tools">

            <ImageView
                android:id="@+id/iv_island_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_prism_orb"
                android:scaleType="centerInside"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Live Activity Pulse Indicator Dot -->
        <View
            android:id="@+id/view_island_live_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_ios_island_lens" />

        <!-- Center Status Label + Right Pill Badge (Tap to Solve; Swipe Down for Modes) -->
        <LinearLayout
            android:id="@+id/ll_island_body"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="7dp">

            <TextView
                android:id="@+id/tv_island_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#F2F2F7"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:maxWidth="148dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_island_answer"
                android:layout_width="wrap_content"
                android:minWidth="40dp"
                android:maxWidth="188dp"
                android:layout_height="28dp"
                android:layout_marginStart="9dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_answer_box"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="?"
                android:textColor="#EEEEEE"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- In-Place Morphing Icon Toolbar: replaces status text right inside the sleek pill when logo is tapped -->
        <LinearLayout
            android:id="@+id/ll_island_inline_tools"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_island_tool_scan"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:background="@drawable/bg_ios_island_lens"
                android:src="@drawable/ic_island_tool_scan"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Solve screen now" />

            <ImageView
                android:id="@+id/btn_island_tool_crop"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_ios_island_lens"
                android:src="@drawable/ic_island_tool_crop"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Crop region to solve" />

            <ImageView
                android:id="@+id/btn_island_tool_resolve"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_ios_island_lens"
                android:src="@drawable/ic_island_tool_resolve"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Wrong answer? Re-solve fresh with Vision" />

            <ImageView
                android:id="@+id/btn_island_tool_mode"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_ios_island_lens"
                android:src="@drawable/ic_island_tool_mode"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Switch question or math mode" />

            <ImageView
                android:id="@+id/btn_island_tool_methods"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_ios_island_lens"
                android:src="@drawable/ic_island_tool_methods"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Switch AI solving engine" />

            <ImageView
                android:id="@+id/btn_island_tool_explain"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_ios_island_lens"
                android:src="@drawable/ic_island_tool_explain"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Show or hide answer explanation" />

            <ImageView
                android:id="@+id/btn_island_tool_stop"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_ios_island_lens"
                android:src="@drawable/ic_island_tool_stop"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Stop Dynamic Island" />

        </LinearLayout>

        <!-- Collapse button kept for backward compatibility (hidden in sleek in-place icon mode) -->
        <ImageView
            android:id="@+id/btn_island_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:padding="6dp"
            android:visibility="gone"
            android:background="@drawable/bg_ios_island_lens"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#AEAEB2"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Collapse Dynamic Island tools" />

    </LinearLayout>

    <!-- Row 2: Two-Tier Expanded iOS Live Activity Quick Controls (morphs vertically, never clips) -->
    <HorizontalScrollView
        android:id="@+id/island_expanded_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_df_part1"
                android:layout_width="wrap_content"
                android:minWidth="38dp"
                android:layout_height="30dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_action"
                android:text="1st"
                android:textColor="#F2F2F7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Capture Part 1 question and diagram" />

            <TextView
                android:id="@+id/btn_df_part2"
                android:layout_width="wrap_content"
                android:minWidth="40dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_action"
                android:text="2nd"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Capture Part 2 options and solve" />

            <TextView
                android:id="@+id/btn_df_scroll_2s"
                android:layout_width="wrap_content"
                android:minWidth="40dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_action"
                android:text="2s↓"
                android:textColor="#F2F2F7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Capture now then scroll for 2 seconds to capture options" />

            <TextView
                android:id="@+id/btn_df_question_mode"
                android:layout_width="wrap_content"
                android:minWidth="46dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_action"
                android:text="STD"
                android:textColor="#FF453A"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Switch question solve mode" />

            <TextView
                android:id="@+id/btn_df_diagram"
                android:layout_width="wrap_content"
                android:minWidth="40dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_action"
                android:text="IMG"
                android:textColor="#F2F2F7"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle Diagram Vision boost" />

            <TextView
                android:id="@+id/btn_df_crop"
                android:layout_width="wrap_content"
                android:minWidth="40dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_action"
                android:text="Box"
                android:textColor="#F2F2F7"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Select region box to scan" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Row 3: iOS Dynamic Island Swipe-Down Quick Mode Switcher -->
    <LinearLayout
        android:id="@+id/ll_island_method_loop_drawer"
        android:layout_width="276dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="7dp"
            android:background="#1E1F25" />

        <TextView
            android:id="@+id/tv_method_loop_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SWITCH SOLVER MODE"
            android:textColor="#8E8E93"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:paddingBottom="6dp" />

        <ScrollView
            android:id="@+id/sv_island_method_loop"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:scrollbars="none"
            android:overScrollMode="always">

            <LinearLayout
                android:id="@+id/ll_island_method_loop_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

    <!-- Row 4: Apple Live Activity Explanation Card -->
    <LinearLayout
        android:id="@+id/ll_island_explanation_drawer"
        android:layout_width="284dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="7dp"
            android:background="#1E1F25" />

        <TextView
            android:id="@+id/tv_island_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="99% Sure • Tap to hide"
            android:textColor="#34D399"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_island_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#F2F2F7"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.18"
            android:maxLines="4"
            android:ellipsize="end" />

        <!-- Anti-Poison Action Strip: Shows Cache/AI source + 1-Tap Wrong? Re-Solve Fresh -->
        <LinearLayout
            android:id="@+id/ll_island_resolve_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_island_source_tag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI Verified"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_island_wrong_resolve"
                android:layout_width="wrap_content"
                android:minHeight="32dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_action"
                android:text="Wrong? Re-Solve"
                android:textColor="#FF453A"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mark answer wrong and re-solve fresh without cache" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
