<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Inner Slab -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#B3111C33"
                android:centerColor="#990D1629"
                android:endColor="#B3090F1C"
                android:angle="270" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Specular Top Rim -->
    <item android:top="0dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Glass Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
