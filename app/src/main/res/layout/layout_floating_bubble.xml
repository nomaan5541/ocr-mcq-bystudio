<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_toolbar_pill"
    android:elevation="16dp"
    android:paddingStart="4dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Floating Prism Orb Bubble -->
    <FrameLayout
        android:id="@+id/bubble_icon_container"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_floating_bubble"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Prism AI Orb">

        <ImageView
            android:id="@+id/iv_bubble_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_prism_orb"
            android:scaleType="centerInside"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Answer Display Box (Tap to Instant-Solve) -->
    <TextView
        android:id="@+id/tv_answer_display"
        android:layout_width="wrap_content"
        android:minWidth="42dp"
        android:maxWidth="148dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_answer_box"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="?"
        android:textColor="#047857"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Expandable Dynamic Flow Helper Chips (Play, Eye, Bot & Opacity% Removed) -->
    <LinearLayout
        android:id="@+id/expanded_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginStart="6dp">

        <TextView
            android:id="@+id/btn_df_part1"
            android:layout_width="wrap_content"
            android:minWidth="34dp"
            android:layout_height="34dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_action"
            android:text="1st"
            android:textColor="#0284C7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Capture Part 1 question and diagram" />

        <TextView
            android:id="@+id/btn_df_part2"
            android:layout_width="wrap_content"
            android:minWidth="36dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_action"
            android:text="2nd"
            android:textColor="#047857"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Capture Part 2 options and solve" />

        <TextView
            android:id="@+id/btn_df_scroll_2s"
            android:layout_width="wrap_content"
            android:minWidth="36dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_action"
            android:text="2s↓"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="2-second scroll capture timer" />

        <TextView
            android:id="@+id/btn_df_question_mode"
            android:layout_width="wrap_content"
            android:minWidth="42dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_action"
            android:text="STD"
            android:textColor="#020617"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Switch Standard, Match the Following, or Complicated Math mode" />

        <ImageView
            android:id="@+id/btn_close_toolbar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#020617"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Collapse Toolbar" />

    </LinearLayout>
</LinearLayout>
