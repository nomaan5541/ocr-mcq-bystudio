<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_toolbar_pill"
    android:elevation="16dp"
    android:paddingStart="4dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Floating Prism Orb Bubble -->
    <FrameLayout
        android:id="@+id/bubble_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_floating_bubble"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Prism AI Orb">

        <ImageView
            android:id="@+id/iv_bubble_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_prism_orb"
            android:scaleType="centerInside"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Expandable Horizontal Toolbar -->
    <LinearLayout
        android:id="@+id/expanded_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginStart="8dp">

        <!-- Play / Scan Button -->
        <FrameLayout
            android:id="@+id/btn_scan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_scan_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Solve Question">

            <ImageView
                android:id="@+id/iv_scan_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Answer Display Box -->
        <TextView
            android:id="@+id/tv_answer_display"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_answer_box"
            android:gravity="center"
            android:text="?"
            android:textColor="#047857"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Toggle Full Gemini Window Button -->
        <ImageView
            android:id="@+id/btn_toggle_window"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:padding="7dp"
            android:background="@drawable/bg_chip_action"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#0284C7"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open Prism AI Window" />

        <!-- Auto-Click Bot Toggle Button -->
        <ImageView
            android:id="@+id/btn_bot_toggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:padding="7dp"
            android:background="@drawable/bg_chip_action"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#0F172A"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Toggle Auto-Tap Answer" />

        <!-- Opacity Toggle Button -->
        <TextView
            android:id="@+id/btn_bubble_opacity"
            android:layout_width="wrap_content"
            android:minWidth="40dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_action"
            android:text="100%"
            android:textColor="#020617"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Change Bubble Opacity" />

        <!-- Close / Collapse Button -->
        <ImageView
            android:id="@+id/btn_close_toolbar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#020617"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Collapse Toolbar" />

    </LinearLayout>
</LinearLayout>
