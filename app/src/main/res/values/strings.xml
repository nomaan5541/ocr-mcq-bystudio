<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Prism AI</string>
    <string name="accessibility_service_description">Prism AI Study Assistant: Reads quiz questions on screen and optionally taps solved options when enabled by you.</string>

    <!-- Header & Navigation -->
    <string name="header_subtitle">Instant Floating Solver</string>
    <string name="nav_home">Home</string>
    <string name="nav_settings">Settings</string>

    <!-- Home Screen -->
    <string name="cta_start_solver">Start Floating Overlay</string>
    <string name="cta_stop_solver">Stop Floating Overlay</string>
    <string name="home_methods_title">Select Answer Method</string>
    <string name="home_methods_subtitle">Choose how the floating overlay solves questions on your screen.</string>
    <string name="home_selected_title">Selected Setup</string>
    <string name="btn_grant">Allow</string>
    <string name="btn_enabled">Allowed</string>
    <string name="btn_open_settings">Open Settings</string>

    <!-- Settings Screen -->
    <string name="settings_keys_title">Local API Keys (Stored on Device Only)</string>
    <string name="settings_keys_subtitle">Enter your AI keys here. Keys are saved strictly locally on your phone and never stored in the app.</string>
    <string name="settings_format_title">Answer Display Format (ABCD vs Charging)</string>
    <string name="settings_format_subtitle" formatted="false">Switch between showing letters A, B, C, D or charging numbers 91%, 92%, 93%, 94%.</string>
    <string name="format_abcd_title">Option Letters (A, B, C, D)</string>
    <string name="format_abcd_desc">Shows solved options directly as A, B, C, D on the floating pill.</string>
    <string name="format_charging_title" formatted="false">Charging Numbers (91, 92, 93, 94)</string>
    <string name="format_charging_desc" formatted="false">Disguises answers as charging percentage: 91% = A, 92% = B, 93% = C, 94% = D.</string>

    <string name="settings_logins_title">Server &amp; Gemini Logins + Permissions</string>
    <string name="settings_overlay_title">Floating Overlay Appearance &amp; Controls</string>
    <string name="style_island_title">Top Dynamic Pill</string>
    <string name="style_island_desc">Compact pill docked near the status bar.</string>
    <string name="style_bubble_title">Draggable Mini Bubble</string>
    <string name="style_bubble_desc">Floating circular badge you can drag anywhere.</string>
    <string name="opacity_label">Overlay Visibility / Opacity</string>

    <string name="haptic_title">Vibration Answer Pulses</string>
    <string name="haptic_desc">1 buzz = A  •  2 buzzes = B  •  3 buzzes = C  •  4 buzzes = D</string>
    <string name="btn_test_vibration">Test 2 Buzzes (Option B)</string>

    <string name="autotap_answer_title">Auto-Tap Solved Option</string>
    <string name="autotap_answer_desc">Automatically taps option A, B, C, or D on screen when solved.</string>
    <string name="autotap_next_title">Auto-Advance Next Question</string>
    <string name="autotap_next_desc">Taps Next or Continue after selecting the solved answer.</string>
    <string name="instant_detect_title">Auto-Detect Question Changes</string>
    <string name="instant_detect_desc">Automatically triggers a new scan when the screen question changes.</string>

    <string name="overlapping_google_title">Overlapping Google Completely</string>
    <string name="overlapping_google_desc">Opens a full interactive floating Google / Gemini window overlapping completely on top of any app.</string>

    <string name="history_title">Quick Test &amp; Solved History</string>
    <string name="history_empty">No recent solved questions saved locally.</string>
    <string name="btn_clear_history">Clear Local</string>
    <string name="btn_solve_sample">Test Solver</string>
    <string name="btn_next_sample">Next Sample</string>

    <!-- Login Activity -->
    <string name="login_header_title">Connect Google Gemini</string>
    <string name="login_done_button">Done</string>
