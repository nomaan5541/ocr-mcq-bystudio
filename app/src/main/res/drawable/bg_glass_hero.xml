<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle Neon Background Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#3300D4FF"
                android:centerColor="#1A6366F1"
                android:endColor="#00060910"
                android:angle="135" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Liquid Glass Inner Slab -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E6101D38"
                android:centerColor="#D90C152B"
                android:endColor="#F0080F20"
                android:angle="270" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <!-- Top Specular Highlight -->
    <item android:top="1dp" android:left="2dp" android:right="2dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#35FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Specular Gradient Rim Stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.2dp"
                android:color="#4D00D4FF" />
        </shape>
    </item>
</layer-list>
