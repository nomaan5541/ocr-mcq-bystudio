<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Daylight White Liquid Glass Toolbar Pill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F8FFFFFF"
                android:centerColor="#F5F8FAFC"
                android:endColor="#F2F1F5F9"
                android:angle="270" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#BBFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <stroke
                android:width="1.2dp"
                android:color="#550284C7" />
        </shape>
    </item>
</layer-list>
