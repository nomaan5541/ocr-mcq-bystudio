<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pure Daylight White Optical Pill Fill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F8FFFFFF"
                android:centerColor="#F5F8FAFC"
                android:endColor="#F2F1F5F9"
                android:angle="270" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Top Specular Fresnel Rim -->
    <item android:top="0dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CCFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Crisp Optical Sky Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <stroke
                android:width="1.3dp"
                android:color="#660284C7" />
        </shape>
    </item>
</layer-list>
