<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Daylight White Gemini Window Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FAFFFFFF"
                android:centerColor="#F7F8FAFC"
                android:endColor="#F5F1F5F9"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1.3dp"
                android:color="#550284C7" />
        </shape>
    </item>
</layer-list>
