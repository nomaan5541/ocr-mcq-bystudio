<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dynamic Island Crimson Red Sensor Lens Fill -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF280B0F"
                android:endColor="#FF110507"
                android:angle="270" />
        </shape>
    </item>
    <!-- Lens Highlight -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#28FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>
    <!-- Crimson Red Scanner Ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#FFD71921" />
        </shape>
    </item>
</layer-list>
